#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd "$SCRIPT_DIR/.." && pwd)

set -o allexport
source "$ROOT_DIR/versions.env"
set +o allexport

source "$ROOT_DIR/lib/config.sh"
source "$ROOT_DIR/lib/log.sh"
source "$ROOT_DIR/lib/commands/doctor.sh"
source "$ROOT_DIR/lib/commands/create.sh"
source "$ROOT_DIR/lib/commands/ci.sh"
source "$ROOT_DIR/lib/commands/update.sh"
source "$ROOT_DIR/lib/commands/sync.sh"
source "$ROOT_DIR/lib/commands/audit.sh"
source "$ROOT_DIR/lib/commands/uninstall.sh"
source "$ROOT_DIR/lib/claude-guard.sh"
source "$ROOT_DIR/lib/codex-guard.sh"

for arg in "$@"; do
  case "$arg" in
    --no-color) MKNEXT_NO_COLOR=1 ;;
    --quiet) MKNEXT_QUIET=1 ;;
  esac
done
init_colors

case "${1:-}" in
  ''|--*|-h|create|ci|doctor|update|sync|audit|uninstall) ;;
  *)
    # The short form is create. Confirm it, because a typo looks like a command.
    if [[ -t 0 && -t 1 && " ${*:2} " != *' --yes '* && " ${*:2} " != *' --quiet '* ]]; then
      ui_confirm "Create a new Next.js app named \"$1\"?" 'Y' || {
        log_info 'Cancelled. Run `mknext --help` to see the commands.'
        exit 0
      }
    fi
    set -- create --name "$1" "${@:2}"
    ;;
esac

print_help() {
  init_colors
  cat <<EOF
${C_BOLD}${C_CYAN}▲ mknext${C_RESET} ${C_DIM}v$(<"$ROOT_DIR/VERSION")${C_RESET} — Production-grade Next.js App Generator

${C_BOLD}USAGE${C_RESET}
  ${C_CYAN}mknext${C_RESET} ${C_DIM}<project-name>${C_RESET} [options]
  ${C_CYAN}mknext create${C_RESET} [--name <name>] [options]
  ${C_CYAN}mknext ci${C_RESET} [options]
  ${C_CYAN}mknext doctor${C_RESET} [options]
  ${C_CYAN}mknext audit${C_RESET} [options]
  ${C_CYAN}mknext sync${C_RESET} [options]
  ${C_CYAN}mknext update${C_RESET}
  ${C_CYAN}mknext uninstall${C_RESET} [--yes]

${C_BOLD}COMMANDS${C_RESET}
  ${C_BOLD}create${C_RESET}       Scaffold a new Next.js app with shadcn, Tailwind, and quality tools
  ${C_BOLD}ci${C_RESET}           Run local or GitHub CI checks in parallel (lint, format, types, audit)
  ${C_BOLD}doctor${C_RESET}       Verify setup and update direct dependencies
  ${C_BOLD}audit${C_RESET}        Run automated security scans (secrets, CVEs, env, supply chain)
  ${C_BOLD}sync${C_RESET}         Synchronize project configs, workflows, and tool pins
  ${C_BOLD}update${C_RESET}       Update the mknext CLI to the latest version
  ${C_BOLD}uninstall${C_RESET}    Remove the mknext CLI from the install prefix

${C_BOLD}OPTIONS${C_RESET}
  ${C_GREEN}--mode${C_RESET} MODE      Use autonomous (default) or guided mode
  ${C_GREEN}--preset${C_RESET} CODE    Set shadcn preset code (default: b67ek3WsVs)
  ${C_GREEN}--region${C_RESET} NAME    Set Vercel region (default: sin1)
  ${C_GREEN}--ci${C_RESET} TARGET      Select CI target (default: local)
  ${C_GREEN}--yes${C_RESET}            Accept default answers
  ${C_GREEN}--dry-run${C_RESET}        Print create steps without file changes
  ${C_GREEN}--force${C_RESET}          Reserved (does not replace targets in v1)
  ${C_GREEN}--no-color${C_RESET}       Turn off color output
  ${C_GREEN}--quiet${C_RESET}          Show only needed output
  ${C_GREEN}--help, -h${C_RESET}       Show this help
  ${C_GREEN}--version${C_RESET}        Show installed version

Doctor checks direct dependencies. Add --update to update them.
EOF
}

case "${1:-}" in
  --version)
    printf 'mknext %s\n' "$(<"$ROOT_DIR/VERSION")"
    ;;
  --help|-h)
    print_help
    ;;
  '')
    if [[ -t 0 && -t 1 ]]; then
      ui_banner
      if ui_confirm "No project specified. Would you like to create a new Next.js app now?" "Y"; then
        load_config
        run_create
        exit 0
      else
        print_help
        exit 0
      fi
    else
      print_help
    fi
    ;;
  doctor)
    shift
    load_config
    while (($#)); do
      case "$1" in
        --mode)
          (($# >= 2)) || { printf 'mknext: --mode needs a value\n' >&2; exit 2; }
          MKNEXT_CONFIG_MODE=$2
          shift 2
          ;;
        --ci)
          (($# >= 2)) || { printf 'mknext: --ci needs a value\n' >&2; exit 2; }
          MKNEXT_CONFIG_CI=$2
          shift 2
          ;;
        --update)
          MKNEXT_DOCTOR_UPDATE=1
          shift
          ;;
        --no-color|--quiet)
          shift
          ;;
        --help|-h)
          print_help
          exit 0
          ;;
        *)
          printf 'mknext: unknown option: %s\n' "$1" >&2
          exit 2
          ;;
      esac
    done
    run_doctor
    ;;
  create)
    shift
    load_config
    while (($#)); do
      case "$1" in
        --name)
          (($# >= 2)) || { log_error '--name needs a value'; exit 2; }
          MKNEXT_CREATE_NAME=$2
          shift 2
          ;;
        --mode)
          (($# >= 2)) || { log_error '--mode needs a value'; exit 2; }
          MKNEXT_CONFIG_MODE=$2
          shift 2
          ;;
        --ci)
          (($# >= 2)) || { log_error '--ci needs a value'; exit 2; }
          MKNEXT_CONFIG_CI=$2
          shift 2
          ;;
        --preset)
          (($# >= 2)) || { log_error '--preset needs a value'; exit 2; }
          MKNEXT_CONFIG_PRESET=$2
          MKNEXT_SET_PRESET=1
          shift 2
          ;;
        --region)
          (($# >= 2)) || { log_error '--region needs a value'; exit 2; }
          MKNEXT_CONFIG_REGION=$2
          MKNEXT_SET_REGION=1
          shift 2
          ;;
        --yes) MKNEXT_CREATE_YES=1; shift ;;
        --force) MKNEXT_CREATE_FORCE=1; shift ;;
        --dry-run) MKNEXT_CREATE_DRY_RUN=1; shift ;;
        --no-color) MKNEXT_NO_COLOR=1; shift ;;
        --quiet) MKNEXT_QUIET=1; shift ;;
        --help|-h) print_help; exit 0 ;;
        *) log_error "unknown option: $1"; exit 2 ;;
      esac
    done
    validate_config || { log_error 'config has an invalid value'; exit 2; }
    run_create
    ;;
  ci)
    shift
    load_config
    while (($#)); do
      case "$1" in
        --ci)
          (($# >= 2)) || { log_error '--ci needs a value'; exit 2; }
          MKNEXT_CONFIG_CI=$2
          shift 2
          ;;
        --no-color) MKNEXT_NO_COLOR=1; shift ;;
        --quiet) MKNEXT_QUIET=1; shift ;;
        --help|-h) print_help; exit 0 ;;
        *) log_error "unknown option: $1"; exit 2 ;;
      esac
    done
    run_ci
    ;;
  update)
    shift
    while (($#)); do
      case "$1" in
        --no-color) MKNEXT_NO_COLOR=1; shift ;;
        --quiet) MKNEXT_QUIET=1; shift ;;
        --help|-h) print_help; exit 0 ;;
        *) log_error "unknown option: $1"; exit 2 ;;
      esac
    done
    run_update
    ;;
  uninstall)
    shift
    while (($#)); do
      case "$1" in
        --yes|-y) MKNEXT_UNINSTALL_YES=1; shift ;;
        --no-color) MKNEXT_NO_COLOR=1; shift ;;
        --quiet) MKNEXT_QUIET=1; shift ;;
        --help|-h) print_help; exit 0 ;;
        *) log_error "unknown option: $1"; exit 2 ;;
      esac
    done
    run_uninstall
    ;;
  sync)
    shift
    while (($#)); do
      case "$1" in
        --dry-run) MKNEXT_SYNC_DRY_RUN=1; shift ;;
        --no-color) MKNEXT_NO_COLOR=1; shift ;;
        --quiet) MKNEXT_QUIET=1; shift ;;
        --help|-h) print_help; exit 0 ;;
        *) log_error "unknown option: $1"; exit 2 ;;
      esac
    done
    run_sync
    ;;
  audit)
    shift
    while (($#)); do
      case "$1" in
        --setup-safe-install) MKNEXT_AUDIT_SETUP_SAFE=1; shift ;;
        --no-color) MKNEXT_NO_COLOR=1; shift ;;
        --quiet) MKNEXT_QUIET=1; shift ;;
        --help|-h) print_help; exit 0 ;;
        *) log_error "unknown option: $1"; exit 2 ;;
      esac
    done
    run_audit
    ;;
  *)
    printf 'mknext: command is not implemented: %s\n' "$1" >&2
    exit 2
    ;;
esac
