#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd "$SCRIPT_DIR/.." && pwd)

source "$ROOT_DIR/lib/config.sh"
source "$ROOT_DIR/lib/log.sh"
source "$ROOT_DIR/lib/commands/doctor.sh"
source "$ROOT_DIR/lib/commands/create.sh"
source "$ROOT_DIR/lib/commands/ci.sh"

case "${1:-}" in
  ''|--*|-h|create|ci|doctor) ;;
  *) set -- create --name "$1" "${@:2}" ;;
esac

print_help() {
  cat <<'EOF'
Usage:
  mknext PROJECT [options]
  mknext create [--name NAME] [options]
  mknext ci [options]
  mknext doctor [options]

Options:
  --mode MODE    Use autonomous or guided mode.
  --ci TARGET    Select the CI target.
  --preset CODE  Set the shadcn preset code.
  --region NAME  Set the Vercel region.
  --yes          Accept default answers.
  --dry-run      Print create steps without file changes.
  --force        Reserved. It does not replace targets in v1.
  --no-color     Turn off color output.
  --quiet        Show only needed output.
  --help         Show this help.
  --version      Show the installed version.

Doctor updates direct dependencies to the latest version allowed by pnpm.
EOF
}

case "${1:-}" in
  --version)
    printf 'mknext %s\n' "$(<"$ROOT_DIR/VERSION")"
    ;;
  --help|-h|'')
    print_help
    ;;
  doctor)
    shift
    load_config
    while (($#)); do
      case "$1" in
        --mode)
          (($# >= 2)) || { printf 'mknext: --mode needs a value\n' >&2; exit 2; }
          MKNEXT_CONFIG_MODE=$2
          shift 2
          ;;
        --ci)
          (($# >= 2)) || { printf 'mknext: --ci needs a value\n' >&2; exit 2; }
          MKNEXT_CONFIG_CI=$2
          shift 2
          ;;
        --no-color|--quiet)
          shift
          ;;
        --help|-h)
          print_help
          exit 0
          ;;
        *)
          printf 'mknext: unknown option: %s\n' "$1" >&2
          exit 2
          ;;
      esac
    done
    run_doctor
    ;;
  create)
    shift
    load_config
    while (($#)); do
      case "$1" in
        --name)
          (($# >= 2)) || { log_error '--name needs a value'; exit 2; }
          MKNEXT_CREATE_NAME=$2
          shift 2
          ;;
        --mode)
          (($# >= 2)) || { log_error '--mode needs a value'; exit 2; }
          MKNEXT_CONFIG_MODE=$2
          shift 2
          ;;
        --ci)
          (($# >= 2)) || { log_error '--ci needs a value'; exit 2; }
          MKNEXT_CONFIG_CI=$2
          shift 2
          ;;
        --preset)
          (($# >= 2)) || { log_error '--preset needs a value'; exit 2; }
          MKNEXT_CONFIG_PRESET=$2
          shift 2
          ;;
        --region)
          (($# >= 2)) || { log_error '--region needs a value'; exit 2; }
          MKNEXT_CONFIG_REGION=$2
          shift 2
          ;;
        --yes) MKNEXT_CREATE_YES=1; shift ;;
        --force) MKNEXT_CREATE_FORCE=1; shift ;;
        --dry-run) MKNEXT_CREATE_DRY_RUN=1; shift ;;
        --no-color) MKNEXT_NO_COLOR=1; shift ;;
        --quiet) MKNEXT_QUIET=1; shift ;;
        --help|-h) print_help; exit 0 ;;
        *) log_error "unknown option: $1"; exit 2 ;;
      esac
    done
    validate_config || { log_error 'config has an invalid value'; exit 2; }
    run_create
    ;;
  ci)
    shift
    load_config
    while (($#)); do
      case "$1" in
        --ci)
          (($# >= 2)) || { log_error '--ci needs a value'; exit 2; }
          MKNEXT_CONFIG_CI=$2
          shift 2
          ;;
        --no-color) MKNEXT_NO_COLOR=1; shift ;;
        --quiet) MKNEXT_QUIET=1; shift ;;
        --help|-h) print_help; exit 0 ;;
        *) log_error "unknown option: $1"; exit 2 ;;
      esac
    done
    run_ci
    ;;
  *)
    printf 'mknext: command is not implemented: %s\n' "$1" >&2
    exit 2
    ;;
esac
