#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

if [[ -n "${MKNEXT_CHECK_LOG:-}" ]]; then
  printf 'pnpm %s\n' "$*" >>"$MKNEXT_CHECK_LOG"
fi

if [[ "${1:-}" == '--version' ]]; then
  printf '%s\n' "${MKNEXT_FAKE_PNPM_VERSION:-12.3.1}"
  exit 0
fi

if [[ "${1:-}" == 'install' && -n "${MKNEXT_EXPECT_PACKAGE_MANAGER:-}" ]]; then
  package_manager=$(node -p "require('./package.json').packageManager")
  if [[ "$package_manager" != "$MKNEXT_EXPECT_PACKAGE_MANAGER" ]]; then
    printf 'wrong package manager before install: %s\n' "$package_manager" >&2
    exit 1
  fi
fi

if [[ "${1:-}" == 'dlx' && "${2:-}" == 'shadcn@latest' && "${3:-}" == 'init' ]]; then
  project_name=''
  preset=''
  template=''

  while (($# > 0)); do
    case "$1" in
      --name)
        project_name=$2
        shift 2
        ;;
      --preset)
        preset=$2
        shift 2
        ;;
      --template)
        template=$2
        shift 2
        ;;
      *) shift ;;
    esac
  done

  if [[ -z "$project_name" || -z "$preset" || "$template" != next ]]; then
    printf 'wrong shadcn setup: name=%s preset=%s template=%s\n' "$project_name" "$preset" "$template" >&2
    exit 1
  fi

  mkdir -p "$project_name/app" "$project_name/lib"
  printf '{"name":"test-app","private":true,"packageManager":"pnpm@11.6.0","scripts":{"lint":"eslint","format":"prettier --write ."},"dependencies":{"@base-ui/react":"^1.7.0","@hugeicons/core-free-icons":"^4.3.0","@hugeicons/react":"^1.1.10","shadcn":"^4.20.1"},"devDependencies":{"eslint":"^9","eslint-config-next":"16.2.6","prettier":"^3.8.3","prettier-plugin-tailwindcss":"^0.8.0"}}\n' >"$project_name/package.json"
  printf 'export default []\n' >"$project_name/eslint.config.mjs"
  printf '{}\n' >"$project_name/.prettierrc"
  printf 'node_modules\n' >"$project_name/.prettierignore"
  printf 'export default {}\n' >"$project_name/next.config.ts"
  printf 'node_modules\n.next\n' >"$project_name/.gitignore"
  printf 'export default function Page(){return <main>Hello</main>}\n' >"$project_name/app/page.tsx"
  printf 'export function cn() {}\n' >"$project_name/lib/utils.ts"
  printf '{"compilerOptions":{"noEmit":true},"include":["next-env.d.ts","**/*.ts","**/*.tsx"]}\n' >"$project_name/tsconfig.json"
  printf '{"style":"base-nova","tailwind":{"config":"","css":"app/globals.css","baseColor":"neutral","cssVariables":true},"rsc":true,"tsx":true,"iconLibrary":"hugeicons","aliases":{"components":"@/components","utils":"@/lib/utils","ui":"@/components/ui","lib":"@/lib","hooks":"@/hooks"}}\n' >"$project_name/components.json"
  exit 0
fi

if [[ "${1:-}" == 'exec' && "${2:-}" == 'changeset' && "${3:-}" == 'init' ]]; then
  printf 'changeset init must not prompt during create\n' >&2
  exit 1
fi

if [[ "${1:-}" == 'exec' && "${2:-}" == 'oxfmt' && "${3:-}" == '--write' ]]; then
  printf 'export default function Page() { return <main>Hello</main>; }\n' >app/page.tsx
  exit 0
fi

if [[ "${1:-}" == 'update' ]]; then
  if [[ "${MKNEXT_FAKE_PNPM_UPDATE_FAIL:-0}" == 1 ]]; then
    printf 'release-age check rejected the update\n' >&2
    exit 1
  fi

  node --input-type=module <<'NODE'
import { readFile, writeFile } from 'node:fs/promises';

const packageData = JSON.parse(await readFile('package.json', 'utf8'));
for (const group of ['dependencies', 'devDependencies', 'optionalDependencies']) {
  for (const name of Object.keys(packageData[group] ?? {})) {
    packageData[group][name] = '99.0.0';
  }
}
await writeFile('package.json', `${JSON.stringify(packageData, null, 2)}\n`);
NODE
  exit 0
fi
